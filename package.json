{
  "name": "cryptoradar-brasil",
  "version": "0.1.0",
  "description": "CryptoRadar Brasil — portal estático de notícias e guias sobre Bitcoin e criptomoedas",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --silent",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && astro check",
    "test": "vitest run",
    "verify": "node scripts/verify-build.mjs",
    "test:mobile": "node scripts/mobile-check.mjs",
    "news:fetch": "node automation/fetch-news.mjs",
    "news:generate": "node automation/generate-articles.mjs",
    "market:update": "node automation/update-market.mjs",
    "ci": "npm run lint && npm test && npm run build && npm run verify"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "fast-xml-parser": "^5.11.2",
    "pagefind": "^1.5.2",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  }
}
