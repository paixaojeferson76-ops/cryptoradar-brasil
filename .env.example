# ============================================================
# CryptoRadar Brasil — variáveis de ambiente
# Copie para .env (local) e/ou cadastre no GitHub:
#   Settings > Secrets and variables > Actions
# Veja API_SETUP.md. NUNCA versione o arquivo .env.
# ============================================================

# Endereço público do site (sem barra no final). Com domínio próprio: https://seudominio.com.br
SITE_URL=https://paixaojeferson76-ops.github.io/cryptoradar-brasil

# ---------- Monetização / métricas (públicos, vão no HTML) ----------
# Google Analytics 4 — ID de medição (formato G-XXXXXXXXXX). Vazio = Analytics desligado.
PUBLIC_GA_ID=
# Google AdSense — ID do editor (formato ca-pub-0000000000000000). Vazio = anúncios desligados.
PUBLIC_ADSENSE_CLIENT=
# IDs dos blocos de anúncio criados no painel do AdSense (opcionais; só números).
PUBLIC_ADSENSE_SLOT_HOME=
PUBLIC_ADSENSE_SLOT_ARTICLE=
PUBLIC_ADSENSE_SLOT_SIDEBAR=
# Google Search Console — só o valor "content" da meta tag de verificação (opcional).
PUBLIC_GOOGLE_SITE_VERIFICATION=
# E-mail público de contato exibido em /contato (opcional).
PUBLIC_CONTACT_EMAIL=

# ---------- Automação de notícias (SECRETOS, nunca vão para o site) ----------
# Chave de IA (Google Gemini, nível gratuito): https://aistudio.google.com/apikey
AI_API_KEY=
# Modelo da IA. Vazio = escolhe sozinho o Gemini Flash estável mais novo (recomendado).
AI_MODEL=
# CoinGecko Demo API (opcional — sem chave usa o endpoint público com limite menor).
CRYPTO_API_KEY=
# true = publica sozinho notícias confirmadas por 2+ veículos. Padrão: false (tudo passa por revisão).
AUTO_PUBLISH=false
