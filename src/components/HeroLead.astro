---
/**
 * Manchete da home: foto em tela cheia, título grande sobre a imagem e os
 * anéis de "radar" da marca. É o elemento de destaque do site.
 */
import { CATEGORIES } from '../config/site';
import { articleHref, type Article } from '../lib/articles';
import { coverOf } from '../lib/images';
import { formatDate, TYPE_LABEL } from '../lib/format';
import { link } from '../lib/url';

interface Props {
  article: Article;
}
const { article } = Astro.props;
const { data } = article;
const cat = CATEGORIES[data.category];
const cover = coverOf(article);
const href = link(articleHref(article));
---

<article class="hero" style={`--h:${cat.hue}`}>
  <img
    class="bg"
    src={cover.src}
    srcset={cover.srcset}
    sizes="(min-width: 1220px) 1220px, 100vw"
    alt={data.imageAlt ?? ''}
    width="1600"
    height="900"
    fetchpriority="high"
    decoding="async"
  />
  <svg class="rings" viewBox="0 0 400 400" aria-hidden="true">
    <circle cx="200" cy="200" r="60"></circle>
    <circle cx="200" cy="200" r="120" stroke-dasharray="3 9"></circle>
    <circle cx="200" cy="200" r="180"></circle>
    <path d="M200 200 L380 200 A180 180 0 0 0 355 110 Z" class="sweep"></path>
    <circle cx="282" cy="150" r="5" class="blip"></circle>
  </svg>
  <div class="content">
    <p class="kicker">
      <a class="cat" href={link(`/${cat.id}`)}>{cat.name}</a>
      <span>{TYPE_LABEL[data.type]}</span>
      <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
    </p>
    <h2><a href={href}>{data.title}</a></h2>
    <p class="desc">{data.description}</p>
  </div>
</article>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: clamp(420px, 62vh, 600px);
    border-radius: var(--radius-l);
    overflow: hidden;
    background: #0c1226;
    color: #fff;
  }

  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .hero:hover .bg {
    transform: scale(1.03);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(8 12 28 / 0) 20%, rgb(8 12 28 / 0.55) 55%, rgb(8 12 28 / 0.94) 100%),
      linear-gradient(90deg, rgb(8 12 28 / 0.55), rgb(8 12 28 / 0) 70%);
  }

  .rings {
    position: absolute;
    top: -90px;
    right: -90px;
    width: 380px;
    height: 380px;
    z-index: -1;
    fill: none;
    stroke: #fff;
    stroke-opacity: 0.35;
    stroke-width: 1.2;
    pointer-events: none;
  }

  .sweep {
    fill: hsl(var(--h) 95% 62% / 0.28);
    stroke: none;
  }

  .blip {
    fill: #ffc83d;
    stroke: none;
  }

  .content {
    padding: clamp(1.25rem, 4vw, 2.75rem);
    max-width: 52rem;
  }

  .kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
    margin-bottom: 0.9rem;
    font-size: var(--step--1);
    color: rgb(255 255 255 / 0.8);
  }

  .kicker .cat {
    color: #fff;
    background: hsl(var(--h) 75% 45% / 0.9);
    padding: 0.25em 0.75em;
    border-radius: 999px;
  }

  .kicker .cat::before {
    background: #fff;
    box-shadow: none;
  }

  h2 {
    font-size: clamp(2rem, 1.3rem + 3.4vw, 3.9rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 800;
    font-stretch: 88%;
    margin: 0 0 0.9rem;
    text-wrap: balance;
  }

  h2 a {
    color: #fff;
    text-decoration: none;
  }

  h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.12em;
  }

  h2 a::after {
    /* torna o card inteiro clicável */
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .kicker a {
    position: relative;
    z-index: 1;
  }

  .desc {
    font-family: var(--font-read);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.15rem);
    line-height: 1.55;
    color: rgb(255 255 255 / 0.86);
    max-width: 60ch;
    margin: 0;
  }

  @media (max-width: 640px) {
    .rings {
      width: 260px;
      height: 260px;
      top: -70px;
      right: -70px;
    }

    .desc {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bg {
      transition: none;
    }
  }
</style>
