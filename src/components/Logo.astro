---
interface Props {
  size?: number;
}
const { size = 34 } = Astro.props;
---

<svg
  class="logo-mark"
  width={size}
  height={size}
  viewBox="0 0 40 40"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="20" cy="20" r="19" fill="#2a3fd6"></circle>
  <circle cx="20" cy="20" r="13" fill="none" stroke="#fff" stroke-opacity=".35" stroke-width="1.5"></circle>
  <circle cx="20" cy="20" r="7" fill="none" stroke="#fff" stroke-opacity=".55" stroke-width="1.5"></circle>
  <path d="M20 20 L36.5 12 A18 18 0 0 1 38 20 Z" fill="#ffc83d" opacity=".9"></path>
  <circle cx="20" cy="20" r="2.4" fill="#fff"></circle>
  <circle cx="29.5" cy="13.5" r="2.2" fill="#ffc83d"></circle>
</svg>
