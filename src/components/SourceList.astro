---
import { formatLongDate } from '../lib/format';

interface Source {
  title: string;
  url: string;
  publisher: string;
  accessed?: Date;
}
interface Props {
  sources: Source[];
}
const { sources } = Astro.props;
const host = (u: string) => new URL(u).hostname.replace(/^www\./, '');
---

{
  sources.length > 0 && (
    <section class="sources" aria-labelledby="fontes">
      <h2 id="fontes">Fontes</h2>
      <ol>
        {sources.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener noreferrer external">
              {s.title}
            </a>
            <span class="pub">
              {s.publisher} ({host(s.url)})
              {s.accessed && <>, consultado em {formatLongDate(s.accessed)}</>}
            </span>
          </li>
        ))}
      </ol>
      <p class="note">Os links abrem em nova aba. Encontrou um erro? Escreva para a redação pela página de contato.</p>
    </section>
  )
}

<style>
  .sources {
    margin-top: 3rem;
    padding: 1.3rem 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
    max-width: 68ch;
  }

  h2 {
    font-size: var(--step-1);
    margin-bottom: 0.8rem;
  }

  ol {
    margin: 0;
    padding-left: 1.3rem;
    display: grid;
    gap: 0.7rem;
  }

  a {
    color: var(--brand);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .pub {
    display: block;
    color: var(--ink-3);
    font-size: 0.88rem;
  }

  .note {
    margin: 1rem 0 0;
    color: var(--ink-3);
    font-size: 0.85rem;
  }
</style>
