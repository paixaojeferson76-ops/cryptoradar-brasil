---
/**
 * Bloco de anúncio do Google AdSense.
 * - Sem PUBLIC_ADSENSE_CLIENT: não renderiza nada em produção (e mostra um
 *   marcador tracejado no `npm run dev`, para visualizar o layout).
 * - Com o ID do editor mas sem o ID do bloco: não renderiza bloco manual
 *   (os "anúncios automáticos" do AdSense ainda podem aparecer).
 * O código segue o formato oficial do AdSense para blocos responsivos.
 */
import { ENV } from '../config/site';

interface Props {
  placement: 'home' | 'article' | 'sidebar';
  class?: string;
}

const { placement, class: className } = Astro.props;
const client = ENV.adsenseClient;
const slot = ENV.adSlots[placement];
const show = Boolean(client && slot);
const dev = import.meta.env.DEV;
---

{
  show && (
    <aside class:list={['ad', className]} aria-label="Publicidade" data-pagefind-ignore>
      <span class="ad-label">Publicidade</span>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={client}
        data-ad-slot={slot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
      <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </aside>
  )
}
{
  !show && dev && (
    <aside class:list={['ad', 'ad-placeholder', className]} aria-hidden="true">
      <span class="ad-label">Espaço publicitário: {placement}</span>
    </aside>
  )
}

<style>
  .ad {
    margin: 2rem 0;
    min-height: 120px;
    text-align: center;
  }

  .ad-label {
    display: block;
    font-size: 0.72rem;
    color: var(--ink-3);
    margin-bottom: 0.3rem;
  }

  .ad-placeholder {
    display: grid;
    place-items: center;
    border: 2px dashed var(--line);
    border-radius: var(--radius-m);
    min-height: 140px;
  }
</style>
