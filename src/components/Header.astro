---
import Logo from './Logo.astro';
import { NAV, MORE_NAV, SITE } from '../config/site';
import { link, stripBase } from '../lib/url';

const current = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href || current.startsWith(href + '/');
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={link('/')} aria-label={`${SITE.name}, página inicial`}>
      <Logo />
      <span class="wordmark">CryptoRadar <span>Brasil</span></span>
    </a>

    <form class="search" action={link('/busca')} method="get" role="search">
      <label for="q-top" class="visually-hidden">Buscar no site</label>
      <input id="q-top" name="q" type="search" placeholder="Buscar notícias e guias" autocomplete="off" />
      <button type="submit" aria-label="Buscar">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"
          ><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.2"></circle><path
            d="M20 20l-4-4"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"></path></svg
        >
      </button>
    </form>

    <details class="menu">
      <summary aria-label="Abrir menu">
        <span class="burger" aria-hidden="true"></span>
        <span class="menu-label">Menu</span>
      </summary>
      <nav class="menu-panel" aria-label="Menu completo">
        <form class="search search-mobile" action={link('/busca')} method="get" role="search">
          <label for="q-menu" class="visually-hidden">Buscar no site</label>
          <input id="q-menu" name="q" type="search" placeholder="Buscar notícias e guias" />
          <button type="submit" class="btn">Buscar</button>
        </form>
        <ul>
          {
            [...NAV, ...MORE_NAV].map((item) => (
              <li>
                <a href={link(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>

  <nav class="wrap primary" aria-label="Seções">
    <ul>
      {
        NAV.map((item) => (
          <li>
            <a href={link(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      {
        MORE_NAV.map((item) => (
          <li class="extra">
            <a href={link(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    position: relative;
    z-index: 20;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--ink);
    margin-right: auto;
  }

  .wordmark {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    font-stretch: 90%;
  }

  .wordmark span {
    font-weight: 450;
    color: var(--ink-2);
  }

  .search {
    display: none;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--paper);
    padding-left: 0.9rem;
  }

  .search input {
    border: 0;
    background: transparent;
    font: inherit;
    color: var(--ink);
    padding: 0.5rem 0;
    width: 15rem;
    min-width: 0;
  }

  .search input:focus {
    outline: none;
  }

  .search:focus-within {
    outline: 3px solid var(--focus);
    outline-offset: 1px;
  }

  .search button {
    border: 0;
    background: none;
    color: var(--ink-2);
    padding: 0.55rem 0.8rem;
    cursor: pointer;
    min-height: 40px;
  }

  .menu summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    min-height: 44px;
    padding: 0 0.3rem;
    font-weight: 600;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
    position: relative;
  }

  .burger::before,
  .burger::after {
    content: '';
    position: absolute;
  }

  .burger::before {
    top: -6px;
  }

  .burger::after {
    top: 6px;
  }

  .menu[open] .burger {
    background: transparent;
  }

  .menu[open] .burger::before {
    top: 0;
    transform: rotate(45deg);
  }

  .menu[open] .burger::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .menu-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    padding: 1rem var(--gutter) 1.5rem;
    box-shadow: 0 18px 30px -18px rgb(19 28 56 / 0.35);
  }

  .menu-panel ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem 1rem;
  }

  .menu-panel a {
    display: block;
    padding: 0.6rem 0;
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px solid var(--line);
  }

  .search-mobile {
    display: flex;
    padding: 0.25rem 0.25rem 0.25rem 0.9rem;
  }

  .search-mobile input {
    flex: 1;
    width: auto;
  }

  .primary {
    display: none;
  }

  .primary ul {
    list-style: none;
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .primary a {
    display: block;
    padding: 0.7rem 0.75rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--ink-2);
    border-bottom: 3px solid transparent;
    white-space: nowrap;
  }

  .primary a:hover {
    color: var(--ink);
  }

  .primary a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--brand);
  }

  .primary li:first-child a {
    padding-left: 0;
  }

  .extra {
    display: none;
  }

  @media (min-width: 900px) {
    .search {
      display: flex;
    }

    .menu {
      display: none;
    }

    .primary {
      display: block;
    }
  }

  @media (min-width: 1180px) {
    .extra {
      display: block;
    }
  }
</style>
