---
import { CATEGORIES } from '../config/site';
import { articleHref, type Article } from '../lib/articles';
import { coverOf } from '../lib/images';
import { formatDate, TYPE_LABEL } from '../lib/format';
import { link } from '../lib/url';

interface Props {
  article: Article;
  variant?: 'lead' | 'standard' | 'row' | 'text';
  headingLevel?: 2 | 3;
  eager?: boolean;
  /** Valor do atributo sizes (largura aproximada que a imagem ocupa). */
  sizes?: string;
}

const { article, variant = 'standard', headingLevel = 3, eager = false, sizes } = Astro.props;
const { data } = article;
const cat = CATEGORIES[data.category];
const href = link(articleHref(article));
const cover = coverOf(article);
const H = `h${headingLevel}` as 'h2' | 'h3';
const imgSizes =
  sizes ?? (variant === 'row' ? '160px' : variant === 'lead' ? '(min-width: 980px) 760px, 100vw' : '(min-width: 980px) 380px, (min-width: 640px) 50vw, 100vw');
---

<article class:list={['card', variant]} style={`--h:${cat.hue}`}>
  {
    variant !== 'text' && (
      <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
        <img
          src={cover.src}
          srcset={cover.srcset}
          sizes={cover.srcset ? imgSizes : undefined}
          alt=""
          width="1600"
          height="900"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={eager ? 'high' : undefined}
        />
      </a>
    )
  }
  <div class="body">
    <a class="cat" href={link(`/${cat.id}`)}>{cat.name}</a>
    <H class="title"><a href={href}>{data.title}</a></H>
    {(variant === 'lead' || variant === 'standard') && <p class="desc">{data.description}</p>}
    <p class="meta">
      <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
      {data.type !== 'noticia' && <span>{TYPE_LABEL[data.type]}</span>}
    </p>
  </div>
</article>

<style>
  .card {
    display: grid;
    gap: 0.85rem;
    align-content: start;
    min-width: 0;
    position: relative;
  }

  .thumb {
    display: block;
    border-radius: var(--radius-m);
    overflow: hidden;
    background: hsl(var(--h) 30% 85%);
    aspect-ratio: 16 / 9;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .card:hover .thumb img {
    transform: scale(1.04);
  }

  .body {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    min-width: 0;
  }

  .title {
    font-size: 1.22rem;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .title a {
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 2px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.3s ease;
  }

  .card:hover .title a,
  .title a:focus-visible {
    background-size: 100% 2px;
    color: inherit;
  }

  .desc {
    color: var(--ink-2);
    margin: 0;
    font-size: 0.97rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta {
    margin: 0.15rem 0 0;
  }

  .lead .title {
    font-size: var(--step-4);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 800;
    font-stretch: 92%;
  }

  .lead .desc {
    font-size: 1.1rem;
    max-width: 58ch;
  }

  .lead .thumb {
    border-radius: var(--radius-l);
  }

  .row {
    grid-template-columns: 1fr 6.5rem;
    gap: 1rem;
    align-items: start;
  }

  .row .thumb {
    order: 2;
    border-radius: var(--radius-s);
    aspect-ratio: 1;
  }

  .row .title {
    font-size: 1rem;
    line-height: 1.28;
    letter-spacing: -0.01em;
  }

  .text .title {
    font-size: 1.05rem;
    line-height: 1.25;
  }

  @media (prefers-reduced-motion: reduce) {
    .thumb img,
    .title a {
      transition: none;
    }
  }
</style>
