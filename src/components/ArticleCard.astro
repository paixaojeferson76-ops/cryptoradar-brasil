---
import { CATEGORIES } from '../config/site';
import { articleHref, type Article } from '../lib/articles';
import { formatDate, TYPE_LABEL } from '../lib/format';
import { link } from '../lib/url';

interface Props {
  article: Article;
  variant?: 'lead' | 'standard' | 'row' | 'text';
  headingLevel?: 2 | 3;
  eager?: boolean;
}

const { article, variant = 'standard', headingLevel = 3, eager = false } = Astro.props;
const { data } = article;
const cat = CATEGORIES[data.category];
const href = link(articleHref(article));
const img = link(data.image ?? `/capas/${article.id}.svg`);
const H = `h${headingLevel}` as 'h2' | 'h3';
---

<article class:list={['card', variant]}>
  {
    variant !== 'text' && (
      <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
        <img
          src={img}
          alt=""
          width="1200"
          height="630"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={eager ? 'high' : undefined}
        />
      </a>
    )
  }
  <div class="body">
    <a class="cat" href={link(`/${cat.id}`)} style={`--h:${cat.hue}`}>{cat.name}</a>
    <H class="title"><a href={href}>{data.title}</a></H>
    {(variant === 'lead' || variant === 'standard') && <p class="desc">{data.description}</p>}
    <p class="meta">
      <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
      {data.type !== 'noticia' && <span>{TYPE_LABEL[data.type]}</span>}
    </p>
  </div>
</article>

<style>
  .card {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    min-width: 0;
  }

  .thumb {
    display: block;
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--line);
    aspect-ratio: 1200 / 630;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    min-width: 0;
  }

  .title {
    font-size: var(--step-1);
    margin: 0;
    line-height: 1.18;
  }

  .title a {
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .desc {
    color: var(--ink-2);
    margin: 0;
    font-size: 0.98rem;
  }

  .meta {
    margin: 0;
  }

  .lead .title {
    font-size: var(--step-4);
    line-height: 1.02;
    letter-spacing: -0.03em;
    font-weight: 800;
    font-stretch: 92%;
  }

  .lead .desc {
    font-size: 1.12rem;
    max-width: 58ch;
  }

  .lead .thumb {
    border-radius: var(--radius-l);
  }

  .row {
    grid-template-columns: 7.5rem 1fr;
    gap: 0.9rem;
    align-items: start;
  }

  .row .thumb {
    border-radius: var(--radius-s);
    aspect-ratio: 4 / 3;
  }

  .row .title {
    font-size: 1.02rem;
    line-height: 1.25;
  }

  .text .title {
    font-size: 1.05rem;
    line-height: 1.25;
  }
</style>
