---
import Logo from './Logo.astro';
import { SITE, NAV, MORE_NAV, LEGAL_NAV } from '../config/site';
import { link } from '../lib/url';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="about">
      <a class="brand" href={link('/')}>
        <Logo size={30} />
        <span>{SITE.name}</span>
      </a>
      <p>{SITE.description}</p>
      <p class="warning">
        Conteúdo informativo e educacional. Nada aqui é recomendação de investimento. Criptoativos são voláteis e
        podem perder valor; decida com cuidado e, se precisar, procure um profissional certificado.
      </p>
    </div>

    <nav aria-label="Categorias">
      <h2>Categorias</h2>
      <ul>
        {
          [...NAV, ...MORE_NAV].map((i) => (
            <li>
              <a href={link(i.href)}>{i.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Institucional">
      <h2>Institucional</h2>
      <ul>
        {
          LEGAL_NAV.map((i) => (
            <li>
              <a href={link(i.href)}>{i.label}</a>
            </li>
          ))
        }
        <li><a href={link('/autor/redacao')}>Redação</a></li>
        <li><a href={link('/rss.xml')}>RSS</a></li>
        <li><a href={link('/sitemap-index.xml')}>Mapa do site</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap legal">
    <p>© {year} {SITE.name}. Cotações: dados da <a href="https://www.coingecko.com/" rel="noopener noreferrer" target="_blank">CoinGecko</a>.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    background: #131c38;
    color: #d3d9ea;
    padding: 3rem 0 1.5rem;
  }

  .site-footer a {
    color: #fff;
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
    color: #fff;
  }

  .grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 760px) {
    .grid {
      grid-template-columns: 1.6fr 1fr 1fr;
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    font-size: 1.15rem;
    margin-bottom: 1rem;
  }

  .about p {
    max-width: 46ch;
    font-size: 0.95rem;
  }

  .warning {
    font-size: 0.85rem !important;
    color: #a9b2cc;
  }

  h2 {
    font-size: 1rem;
    color: #fff;
    margin-bottom: 0.8rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: 1rem;
  }

  li {
    padding: 0.3rem 0;
    font-size: 0.95rem;
    break-inside: avoid;
  }

  .legal {
    border-top: 1px solid #2c3656;
    margin-top: 2rem;
    padding-top: 1.2rem;
    font-size: 0.85rem;
    color: #a9b2cc;
  }

  .legal a {
    text-decoration: underline;
  }
</style>
