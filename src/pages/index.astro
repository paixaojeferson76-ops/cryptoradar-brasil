---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import MarketPanel from '../components/MarketPanel.astro';
import Advertisement from '../components/Advertisement.astro';
import { getPublished, inCategory, type Article } from '../lib/articles';
import { CATEGORIES, SITE, type CategoryId } from '../config/site';
import { link } from '../lib/url';

const all = await getPublished();
const lead = all.find((a) => a.data.featured) ?? all[0];
const used = new Set<string>([lead?.id]);
const take = (list: Article[], n: number, fill = false) => {
  const out = list.filter((a) => !used.has(a.id)).slice(0, n);
  out.forEach((a) => used.add(a.id));
  // Completa a seção com itens já exibidos acima, para não deixar coluna vazia.
  if (fill && out.length < n) out.push(...list.filter((a) => !out.includes(a) && a.id !== lead?.id).slice(0, n - out.length));
  return out;
};

const latest = take(all, 5);
const relevant = take(
  all.filter((a) => a.data.featured),
  4,
);
if (relevant.length < 4) relevant.push(...take(all, 4 - relevant.length));

const sections: { id: CategoryId | 'guias'; title: string; href: string; items: Article[] }[] = [];
for (const id of ['bitcoin', 'ethereum', 'mercado', 'regulacao', 'tecnologia'] as CategoryId[]) {
  sections.push({ id, title: CATEGORIES[id].name, href: `/${id}`, items: take(inCategory(all, id), 3, true) });
}
sections.push({
  id: 'guias',
  title: 'Guias para começar',
  href: '/guias',
  items: take(
    all.filter((a) => a.data.type === 'guia'),
    4,
    true,
  ),
});
---

<BaseLayout title={SITE.name} description={SITE.description} path="/">
  <div class="wrap">
    <h1 class="visually-hidden">{SITE.name}: notícias e guias sobre Bitcoin e criptomoedas</h1>

    <div class="top">
      {lead && <ArticleCard article={lead} variant="lead" headingLevel={2} eager />}

      <aside class="latest" aria-labelledby="ultimas">
        <h2 id="ultimas">Últimas publicações</h2>
        <ul>
          {
            latest.map((a) => (
              <li>
                <ArticleCard article={a} variant="row" />
              </li>
            ))
          }
        </ul>
        <a class="all" href={link('/noticias')}>Ver todas as publicações</a>
      </aside>
    </div>

    <Advertisement placement="home" />

    <div class="middle">
      <section aria-labelledby="relevantes">
        <div class="section-head"><h2 id="relevantes">Mais relevantes</h2></div>
        <div class="grid-3">
          {relevant.map((a) => <ArticleCard article={a} />)}
        </div>
      </section>
      <div class="side">
        <MarketPanel />
        <form class="home-search" action={link('/busca')} method="get" role="search">
          <label for="q-home">Procure um assunto</label>
          <div>
            <input id="q-home" name="q" type="search" placeholder="Ex.: halving, stablecoin, ETF" />
            <button class="btn" type="submit">Buscar</button>
          </div>
        </form>
      </div>
    </div>

    {
      sections
        .filter((s) => s.items.length > 0)
        .map((s) => (
          <section aria-labelledby={`sec-${s.id}`} class="cat-section">
            <div class="section-head">
              <h2 id={`sec-${s.id}`}>{s.title}</h2>
              <a href={link(s.href)}>Mais em {s.id === 'guias' ? 'Guias' : s.title}</a>
            </div>
            <div class:list={[s.items.length > 3 ? 'grid-4' : 'grid-3']}>
              {s.items.map((a) => (
                <ArticleCard article={a} />
              ))}
            </div>
          </section>
        ))
    }

    <Advertisement placement="home" />
  </div>
</BaseLayout>

<style>
  .top {
    display: grid;
    gap: 2rem;
    padding-top: 1.75rem;
  }

  .latest h2 {
    font-size: var(--step-1);
    border-bottom: 2px solid var(--ink);
    padding-bottom: 0.4rem;
    margin-bottom: 0.4rem;
  }

  .latest ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .latest li {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
  }

  .all {
    display: inline-block;
    margin-top: 0.9rem;
    font-weight: 650;
    color: var(--brand);
  }

  .middle {
    display: grid;
    gap: 2rem;
  }

  .side {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .home-search label {
    display: block;
    font-weight: 650;
    margin-bottom: 0.4rem;
  }

  .home-search div {
    display: flex;
    gap: 0.5rem;
  }

  .home-search input {
    flex: 1;
    min-width: 0;
    font: inherit;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
  }

  .grid-3,
  .grid-4 {
    display: grid;
    gap: 1.75rem 1.5rem;
  }

  @media (min-width: 640px) {
    .grid-3,
    .grid-4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 980px) {
    .top {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      gap: 2.5rem;
    }

    .middle {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      gap: 2.5rem;
    }

    .middle .grid-3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .side {
      margin-top: 3rem;
    }

    .grid-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .grid-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
