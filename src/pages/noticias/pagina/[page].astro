---
import type { GetStaticPaths } from 'astro';
import NewsIndex from '../../../components/NewsIndex.astro';
import { getPublished } from '../../../lib/articles';
import { pageCount, pageSlice } from '../../../lib/paging';

export const getStaticPaths = (async () => {
  const all = await getPublished();
  const total = pageCount(all.length);
  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { articles: pageSlice(all, i + 2), total },
  }));
}) satisfies GetStaticPaths;

const { articles, total } = Astro.props;
---

<NewsIndex articles={articles} page={Number(Astro.params.page)} total={total} />
